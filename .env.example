# Copy this file to .env and fill in real values.
# Nothing in this file is required to run the hackathon demo --
# all agents fall back to simulated/offline behavior when a key is missing.

# --- LLM provider (optional upgrade from rule-based Intake/Triage) ---
LLM_PROVIDER=none
GEMINI_API_KEY=
OPENAI_API_KEY=

# --- Google Maps (optional upgrade from haversine-distance estimate) ---
GOOGLE_MAPS_API_KEY=

# --- Twilio (optional upgrade from simulated WhatsApp/SMS logging) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=

# --- Firebase (optional upgrade from local-file simulated hospital status) ---
FIREBASE_CREDENTIALS_PATH=

# --- Database (optional upgrade from in-memory storage) ---
DATABASE_URL=

# --- App ---
DEMO_MODE=true
CORS_ALLOWED_ORIGINS=*
