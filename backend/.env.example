# =====================================================
# AI HEALTHCARE COORDINATION PLATFORM
# Backend Environment Variables
# =====================================================
# Copy this file to .env and fill in your real values.

# =====================================================
# APP CONFIGURATION
# =====================================================
ENV=development
DEBUG=True

HOST=0.0.0.0
PORT=8000

# =====================================================
# GEMINI (Primary LLM Provider)
# =====================================================
LLM_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_here

GEMINI_PRO_MODEL=gemini-2.5-pro
GEMINI_FLASH_MODEL=gemini-2.5-flash
GEMINI_EMBEDDING_MODEL=text-embedding-004

# =====================================================
# GROQ (Speech-to-Text)
# =====================================================
GROQ_API_KEY=your_groq_api_key_here

GROQ_STT_MODEL=whisper-large-v3

# =====================================================
# FIREBASE ADMIN
# =====================================================
FIREBASE_PROJECT_ID=your_firebase_project_id
FIREBASE_SERVICE_ACCOUNT=serviceAccount.json

# =====================================================
# SUPABASE (Optional — future use)
# =====================================================
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# =====================================================
# QDRANT (Vector Database for RAG)
# =====================================================
QDRANT_URL=https://your-qdrant-instance.cloud.qdrant.io
QDRANT_API_KEY=your_qdrant_api_key
QDRANT_COLLECTION=medical_knowledge

# =====================================================
# REDIS (Session Store & Shared Memory)
# =====================================================
REDIS_HOST=your-redis-host.redis.io
REDIS_PORT=19165
REDIS_PASSWORD=your_redis_password
REDIS_URL=redis://default:your_redis_password@your-redis-host.redis.io:19165

# =====================================================
# GOOGLE MAPS (Optional)
# =====================================================
# GOOGLE_MAPS_API_KEY=

# =====================================================
# OPTIONAL SERVICES
# =====================================================

# CloudAMQP (RabbitMQ)
# RABBITMQ_URL=

# Twilio (SMS/WhatsApp Notifications)
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_PHONE_NUMBER=

# SMTP (Email Notifications)
# SMTP_HOST=
# SMTP_PORT=
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_FROM_EMAIL=
